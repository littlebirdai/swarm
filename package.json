{
  "name": "codecast",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "start": "cd apps/web && bun run start",
    "dev": "./dev.sh",
    "build": "turbo run build --filter='!@codecast/electron' --filter='!mobile'",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "bun scripts/lint.ts",
    "lint:prune": "bun scripts/lint.ts --prune",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "postinstall": "bash patches/convex-auth-iss-fix.sh"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.91.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@codecast/web": "workspace:*",
    "convex": "^1.31.6"
  },
  "overrides": {
    "@radix-ui/react-slot": "1.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
