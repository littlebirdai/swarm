# Copy to apps/web/.env.local.
# The Convex dev deployment: https://<dev-deployment>.convex.cloud
VITE_CONVEX_URL=
# The relay (optional): ws://127.0.0.1:3100 for a local relay.
VITE_RELAY_URL=

# Feature flags. Set to 1 to turn a feature on. All are off when unset.
VITE_SWARM_TURN_BATON=
VITE_RELAY_INBOX_LIVENESS=
VITE_INBOX_LOG_SNAPSHOT=
VITE_CODECAST_FORCED_DEVICE_MOVE_V1=

# Error reporting and analytics. Leave empty: Swarm has no account yet.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_CODECAST_INGEST_KEY=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
