{
  "name": "@codecast/cli",
  "version": "1.1.265",
  "description": "Sync coding agent conversations to a shared Convex database",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codecast": "./dist/main.js",
    "cast": "./dist/main.js"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun scripts/stamp-daemon-build-id.ts && bun scripts/build-with-native.ts src/main.ts src/daemon.ts --outdir dist --target=node --splitting",
    "build:binary": "bash scripts/guard-no-src-shadow.sh && bun scripts/build-with-native.ts src/main.ts --compile --outfile codecast",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "bun test ./src/",
    "test:learning": "bun test ./learning/",
    "test:computer": "bun test ./src/computer/ --isolate --path-ignore-patterns=''"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@anthropic-ai/sdk": "^0.71.2",
    "@codecast/agent-clients": "workspace:*",
    "@codecast/agents": "workspace:*",
    "@codecast/artifacts": "workspace:*",
    "@codecast/async": "workspace:*",
    "@codecast/blame": "workspace:*",
    "@codecast/browser": "workspace:*",
    "@codecast/calls": "workspace:*",
    "@codecast/capabilities": "workspace:*",
    "@codecast/cloud-hosts": "workspace:*",
    "@codecast/comments": "workspace:*",
    "@codecast/connectors": "workspace:*",
    "@codecast/convex-errors": "workspace:*",
    "@codecast/daemon": "workspace:*",
    "@codecast/decisions": "workspace:*",
    "@codecast/deploys": "workspace:*",
    "@codecast/diff": "workspace:*",
    "@codecast/docs": "workspace:*",
    "@codecast/entities": "workspace:*",
    "@codecast/evals-api": "workspace:*",
    "@codecast/fence": "workspace:*",
    "@codecast/files": "workspace:*",
    "@codecast/flows": "workspace:*",
    "@codecast/goals": "workspace:*",
    "@codecast/ingest": "workspace:*",
    "@codecast/keyboard": "workspace:*",
    "@codecast/machines": "workspace:*",
    "@codecast/memory": "workspace:*",
    "@codecast/messages": "workspace:*",
    "@codecast/mods": "workspace:*",
    "@codecast/network": "workspace:*",
    "@codecast/org": "workspace:*",
    "@codecast/org-templates": "workspace:*",
    "@codecast/pages": "workspace:*",
    "@codecast/policy": "workspace:*",
    "@codecast/projects": "workspace:*",
    "@codecast/provider-keys": "workspace:*",
    "@codecast/pull-requests": "workspace:*",
    "@codecast/ratchet": "workspace:*",
    "@codecast/render": "workspace:*",
    "@codecast/replay": "workspace:*",
    "@codecast/search": "workspace:*",
    "@codecast/sessions": "workspace:*",
    "@codecast/shared": "workspace:*",
    "@codecast/ship": "workspace:*",
    "@codecast/signals": "workspace:*",
    "@codecast/team": "workspace:*",
    "@codecast/time": "workspace:*",
    "@codecast/triggers": "workspace:*",
    "@codecast/usage": "workspace:*",
    "@codecast/vault": "workspace:*",
    "@inquirer/prompts": "^8.2.0",
    "@platform/auth": "file:../../platform/packages/auth",
    "@platform/cli-kit": "file:../../platform/packages/cli-kit",
    "@platform/evals": "file:../../platform/packages/evals",
    "@platform/snippets": "file:../../platform/packages/snippets",
    "@types/ws": "^8.18.1",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "convex": "1.31.2",
    "open": "^11.0.0",
    "tldts": "^7.4.10",
    "ws": "8.21.3"
  },
  "optionalDependencies": {
    "e2b": "^2.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
