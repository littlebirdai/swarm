# Copy to apps/cli/.env.local, or export these in the shell that runs the
# daemon from source. Without them the CLI uses codecast's servers and the
# ~/.codecast folder of the codecast daemon on this machine.

# A separate state folder, for example ~/.swarm-dev
CODECAST_DIR=
# The Convex dev deployment: https://<dev-deployment>.convex.cloud
CONVEX_URL=
# The web dev server: http://localhost:3200
CODE_CHAT_SYNC_WEB_URL=

# Feature flags. Set to 1 to turn a feature on. All are off when unset.
CODECAST_EDGE_V1=
CODECAST_CODEX_OWNED_NEW_SESSIONS=
CODECAST_EDGE_TRANSCRIPT_UPLINK_V1=
CODECAST_MEMORY_PARKING_V1=
CODECAST_RELAY_LIVENESS_PUBLISH=
CODECAST_EDGE_SUPERVISOR_V1=
CODECAST_TERMINAL_TYPING=

# AI search (optional, for `cast ask`)
ANTHROPIC_API_KEY=
