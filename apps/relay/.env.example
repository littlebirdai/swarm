# Copy to apps/relay/.env.local, or export these before `bun src/main.ts`.
# RELAY_AUDIENCE and RELAY_HMAC_KEY must equal the values on the Convex deployment.
RELAY_AUDIENCE=
RELAY_HMAC_KEY=
# Optional. Uncomment only to change the defaults (127.0.0.1 and 3100):
# an empty value is refused.
# RELAY_HOST=
# RELAY_PORT=
