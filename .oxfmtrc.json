{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    ".next/",
    "out/",
    ".turbo/",
    "data/",
    "!apps/playground/src/data/",
    "!apps/web/components/data/",
    "output.txt",
    ".codex/",
    ".claude/",
    "pnpm-lock.yaml",
    "*.snapshot.json",
    "bun.lock",
    "platform/",
    ".oxlintrc.json",
    "lint-baseline.json",
    "**/_generated/",
    "**/*.generated.ts",
    "apps/mobile/ios/",
    "apps/mobile/android/",
    "apps/mobile/.expo/",
    "apps/mobile/expo-env.d.ts",
    "apps/mobile/build-output/",
    "apps/mobile/lib/vendor/*Source.ts",
    "apps/cli/src/daemonBuildId.ts",
    "apps/cli/src/__fixtures__/install-golden/",
    "plans/security-entrypoint-inventory.json",
    "plans/security-entrypoint-inventory.md",
    "packages/shared/ratchet/doc-refs-baseline.txt",
    "packages/shared/ratchet/max-lines-baseline.txt"
  ]
}
