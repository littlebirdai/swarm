          "TEST_MOBILE": "\${{ needs.test-mobile.result }}",
          "TEST_MOBILE_SHOULD_RUN": "\${{ needs.code_paths.outputs.run_test_mobile }}",
          "TEST_MODELS": "\${{ needs.test-models.result }}",
          "TEST_MODELS_SHOULD_RUN": "\${{ needs.code_paths.outputs.run_test_models }}",
          "TEST_PLATFORM": "\${{ needs.test-platform.result }}",
          "TEST_PLATFORM_SHOULD_RUN": "\${{ needs.code_paths.outputs.run_test_platform }}",
          "TEST_SHARED": "\${{ needs.test-shared.result }}",
          "TEST_SHARED_SHOULD_RUN": "\${{ needs.code_paths.outputs.run_test_shared }}",
          "TEST_WEB": "\${{ needs.test-web.result }}",
          "TEST_WEB_SHOULD_RUN": "\${{ needs.code_paths.outputs.run_test_web }}",
          "TYPECHECK": "\${{ needs.typecheck.result }}",
          "TYPECHECK_SHOULD_RUN": "\${{ needs.code_paths.outputs.run_typecheck }}",
        },
        "name": "Require every check",
        "run": 
"failed=0
# The ungated jobs. If code_paths or ci-contract did not succeed, the
# gates below were computed by code nobody verified; test-always runs
# on every change because no gate can cover it.
if [ "$CODE_PATHS" != "success" ]; then
  echo "code_paths: expected success, got $CODE_PATHS"
  failed=1
fi
if [ "$CI_CONTRACT" != "success" ]; then
  echo "ci-contract: expected success, got $CI_CONTRACT"
  failed=1
fi
if [ "$TEST_ALWAYS" != "success" ]; then
  echo "test-always: expected success, got $TEST_ALWAYS"
  failed=1
fi
check_job() {
  name="$1" result="$2" should="$3"
  case "$should" in
    true | false) ;;
    *)
      echo "$name: the classifier gave no decision"
      failed=1
      return
      ;;
  esac
  if [ "$should" = "true" ]; then
    if [ "$result" != "success" ]; then
      echo "$name: expected success, got $result"
      failed=1
    fi
  elif [ "$result" != "skipped" ]; then
    echo "$name: expected skipped, got $result"
    failed=1
  fi
}
check_job build "$BUILD" "$BUILD_SHOULD_RUN"
check_job typecheck "$TYPECHECK" "$TYPECHECK_SHOULD_RUN"
check_job lint "$LINT" "$LINT_SHOULD_RUN"
check_job test-convex "$TEST_CONVEX" "$TEST_CONVEX_SHOULD_RUN"
check_job test-web "$TEST_WEB" "$TEST_WEB_SHOULD_RUN"
check_job test-cli "$TEST_CLI" "$TEST_CLI_SHOULD_RUN"
check_job test-platform "$TEST_PLATFORM" "$TEST_PLATFORM_SHOULD_RUN"
check_job test-shared "$TEST_SHARED" "$TEST_SHARED_SHOULD_RUN"
check_job test-mobile "$TEST_MOBILE" "$TEST_MOBILE_SHOULD_RUN"
check_job test-electron "$TEST_ELECTRON" "$TEST_ELECTRON_SHOULD_RUN"
check_job test-models "$TEST_MODELS" "$TEST_MODELS_SHOULD_RUN"
exit "$failed"
"
,
      },
    ],
  },
}
`;

exports[`pinned content turbo.json and the typecheck command are the reviewed ones 1`] = `
{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "packages/tsconfig/*.json",
    "patches/**",
  ],
  "tasks": {
    "build": {
      "cache": false,
      "passThroughEnv": [
        "RAILWAY_GIT_COMMIT_SHA",
        "GIT_SHA",
      ],
    },
    "build:check": {
      "env": [
        "VITE_*",
        "NODE_ENV",
        "BUILD_NODE_VERSION",
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/**",
        "$TURBO_ROOT$/apps/server/**",
        "$TURBO_ROOT$/apps/web/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/platform/**",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/platform/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/apps/*/dist/**",
        "!$TURBO_ROOT$/apps/**/*.test.ts",
        "!$TURBO_ROOT$/apps/**/*.test.tsx",
        "!$TURBO_ROOT$/packages/*/test/**",
      ],
      "outputs": [],
      "passThroughEnv": [
        "NODE_OPTIONS",
      ],
    },
    "lint": {
      "cache": false,
    },
    "test": {
      "cache": false,
    },
    "typecheck": {
      "cache": false,
    },
  },
}
`;

exports[`pinned content turbo.json and the typecheck command are the reviewed ones 2`] = `
"import { join } from "node:path";

const ROOT = join(import.meta.dir, "..", "..");

export const LOCAL_ONLY_PROGRAMS = ["mobile"];

export async function typecheckPrograms(): Promise<Record<string, string>> {
  const config = Bun.TOML.parse(
    await Bun.file(join(ROOT, ".codecast/check.toml")).text(),
  ) as { projects: Record<string, string> };
  return Object.fromEntries(
    Object.entries(config.projects).filter(
      ([name]) => !LOCAL_ONLY_PROGRAMS.includes(name),
    ),
  );
}

if (import.meta.main) {
  const programs = await typecheckPrograms();
  const names = process.argv.slice(2);
  if (names.length === 0) names.push(...Object.keys(programs));
  const unknown = names.filter((name) => !Object.hasOwn(programs, name));
  if (unknown.length > 0) {
    console.error(\`::error::Unknown typecheck programs: \${unknown.join(", ")}\`);
    process.exit(1);
  }
  const failed: string[] = [];
  await Promise.all(
    names.map(async (name) => {
      const started = performance.now();
      const proc = Bun.spawn(
        [
          join(ROOT, "node_modules/.bin/tsgo"),
          "--noEmit",
          "--checkers",
          "1",
          "--incremental",
          "false",
          "-p",
          programs[name],
        ],
        { cwd: ROOT, stdio: ["inherit", "inherit", "inherit"] },
      );
      const code = await proc.exited;
      const seconds = Math.round((performance.now() - started) / 1000);
      console.log(\`\${name}: exit \${code} in \${seconds}s\`);
      if (code !== 0) failed.push(name);
    }),
  );
  if (failed.length > 0) {
    console.error(\`::error::Typecheck failed in \${failed.join(", ")}\`);
    process.exit(1);
  }
}
"
`;
