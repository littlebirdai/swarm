// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`pinned content every job's steps are the reviewed ones 1`] = `
{
  "build": {
    "defaults": undefined,
    "env": undefined,
    "services": undefined,
    "steps": [
      {
        "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
      },
      {
        "uses": "./.github/actions/setup-bun",
      },
      {
        "if": "matrix.target == 'web'",
        "name": "Turborepo cache",
        "uses": "actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9",
        "with": {
          "key": "turbo-\${{ runner.os }}-\${{ github.sha }}-\${{ github.run_attempt }}",
          "path": ".turbo/cache",
          "restore-keys": "turbo-\${{ runner.os }}-",
        },
      },
      {
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192",
        },
        "if": "matrix.target == 'web'",
        "name": "Build the web app",
        "run": "BUILD_NODE_VERSION="$(node --version)" bunx turbo run build:check --filter=@codecast/web",
      },
      {
        "if": "matrix.target == 'other'",
        "name": "Load the scripts that follow the web bundle",
        "run": "bun build scripts/precompress.mjs scripts/carry-assets.mjs scripts/prerender.mjs scripts/indexnow.mjs ../../scripts/ci/verify-telemetry-key.mjs --target=node --packages=external --outdir="$RUNNER_TEMP/web-build-scripts"",
        "working-directory": "apps/web",
      },
      {
        "if": "matrix.target == 'other'",
        "name": "Build everything else",
        "run": "bun run build --filter='!@codecast/web'",
      },
    ],
  },
  "ci-contract": {
    "defaults": undefined,
    "env": undefined,
    "services": undefined,
    "steps": [
      {
        "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "with": {
          "fetch-depth": 0,
          "filter": "blob:none",
        },
      },
      {
        "uses": "./.github/actions/setup-bun",
      },
      {
        "env": {
          "EDGE_RELEASE_BASE": "\${{ github.event.pull_request.base.sha || github.event.before }}",
        },
        "name": "Unit tests (ci scripts + workflow contract)",
        "run": "bun test scripts/ci/",
      },
    ],
  },
  "code_paths": {
    "defaults": undefined,
    "env": undefined,
    "services": undefined,
    "steps": [
      {
        "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
        "with": {
          "fetch-depth": 0,
          "filter": "blob:none",
          "sparse-checkout": 
".github
scripts
"
,
        },
      },
      {
        "uses": "./.github/actions/setup-bun",
        "with": {
          "deps": "none",
        },
      },
      {
        "env": {
          "EVENT_NAME": "\${{ github.event_name }}",
          "PR_BASE_SHA": "\${{ github.event.pull_request.base.sha }}",
          "PR_HEAD_SHA": "\${{ github.event.pull_request.head.sha }}",
          "PUSH_BEFORE_SHA": "\${{ github.event.before }}",
          "PUSH_SHA": "\${{ github.sha }}",
        },
        "id": "diff",
        "name": "List changed paths",
        "run": 
"set -uo pipefail
list="$RUNNER_TEMP/changed-paths.txt"
: > "$list"
base="" head=""
if [ "$EVENT_NAME" = "pull_request" ] && [ -n "$PR_BASE_SHA" ] && [ -n "$PR_HEAD_SHA" ]; then
  base="$(git merge-base "$PR_BASE_SHA" "$PR_HEAD_SHA" || true)"
  head="$PR_HEAD_SHA"
elif [ "$EVENT_NAME" = "push" ] && [ -n "$PUSH_BEFORE_SHA" ] \\
  && [ "$PUSH_BEFORE_SHA" != "0000000000000000000000000000000000000000" ] \\
  && git cat-file -e "$PUSH_BEFORE_SHA^{commit}" 2>/dev/null; then
  base="$PUSH_BEFORE_SHA"
  head="$PUSH_SHA"
fi
if [ -n "$base" ]; then
  echo "Diffing $base..$head ($EVENT_NAME)"
  # A failed diff must not leave a partial list behind.
  git diff --name-only --no-renames "$base" "$head" > "$list.tmp" && mv "$list.tmp" "$list"
else
  echo "No diff base for this $EVENT_NAME event: running every job"
fi
echo "list=$list" >> "$GITHUB_OUTPUT"
echo "Changed paths:"
cat "$list"
"
,
      },
      {
        "id": "scope",
        "name": "Classify changed paths",
        "run": 
"set -o pipefail
bun scripts/ci/changed-path-scope.ts < "\${{ steps.diff.outputs.list }}" | tee -a "$GITHUB_OUTPUT"
"
,
      },
      {
        "id": "computer_scope",
        "name": "Classify computer changes",
        "run": 
"set -o pipefail
bun scripts/ci/changed-path-scope.ts --computer-only < "\${{ steps.diff.outputs.list }}" | tee -a "$GITHUB_OUTPUT"
"
,
      },
      {
        "id": "injection_scope",
        "name": "Classify injection-path changes",
        "run": 
"set -o pipefail
bun scripts/ci/changed-path-scope.ts --injection-only < "\${{ steps.diff.outputs.list }}" | tee -a "$GITHUB_OUTPUT"
"
,
      },
    ],
  },
